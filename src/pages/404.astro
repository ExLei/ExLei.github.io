---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../config";
---
<BaseLayout title="404" pagefindIgnore>
	<main class="mx-auto flex w-full max-w-2xl flex-col items-center px-4 pt-32 pb-12">
		<h1 class="font-mono text-6xl font-bold">404</h1>
		<p class="mt-4 text-ink-secondary">页面不存在</p>
		<a
			href={withBase("/")}
			class="mt-8 rounded-xl border border-hairline px-5 py-2.5 transition-colors hover:bg-paper-muted"
		>
			返回首页
		</a>
	</main>
</BaseLayout>
