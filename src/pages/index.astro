---
import BaseLayout from "../layouts/BaseLayout.astro";
import FilterPanel from "../components/FilterPanel.svelte";
import PostList from "../components/PostList.svelte";
import { getAllPostData } from "../lib/posts";
import { siteConfig } from "../config";

const data = await getAllPostData();
---
<BaseLayout>
	<main class="w-full px-4 pt-14 pb-12">
		<header class="mx-auto mb-8 w-full max-w-2xl border-b border-hairline pb-6">
			<h1 class="text-3xl font-bold tracking-tight">{siteConfig.title}</h1>
			<p class="mt-2 text-sm text-ink-secondary">{siteConfig.subtitle}</p>
		</header>

		<div class="mx-auto w-full max-w-2xl">
			<details class="mb-6 rounded-xl border border-hairline md:hidden">
				<summary class="cursor-pointer select-none px-4 py-3 font-mono text-xs uppercase tracking-wider text-ink-tertiary">
					筛选
				</summary>
				<div class="border-t border-hairline px-4 py-4">
					<FilterPanel client:load />
				</div>
			</details>

			<PostList client:load posts={data} />
		</div>
	</main>
</BaseLayout>
