---
import BaseLayout from "../layouts/BaseLayout.astro";
import FilterPanel from "../components/FilterPanel.svelte";
import PostList from "../components/PostList.svelte";
import { getAllPosts } from "../lib/posts";
import { readingTime } from "../lib/reading-time";
import { homeConfig, siteConfig } from "../config";

const posts = await getAllPosts();
const data = posts.map((p) => ({
	slug: p.id,
	title: p.data.title,
	description: p.data.description,
	published: p.data.published.toISOString(),
	tags: p.data.tags,
	category: p.data.category,
	readingMinutes: readingTime(p.body ?? ""),
}));
const position = homeConfig.sidebarPosition;
---
<BaseLayout>
	<main class="w-full px-4 pt-14 pb-32">
		<header class="mx-auto mb-8 w-full max-w-4xl border-b border-hairline pb-6">
			<h1 class="text-3xl font-bold tracking-tight">{siteConfig.title}</h1>
			<p class="mt-2 text-sm text-ink-secondary">{siteConfig.subtitle}</p>
		</header>

		<div class="mx-auto flex w-full max-w-4xl items-start gap-10">
			{position === "left" && (
				<aside class="hidden w-48 shrink-0 xl:block" aria-label="筛选">
					<div class="sticky top-6 max-h-[calc(100dvh-3rem)] overflow-y-auto rounded-xl border border-hairline bg-paper p-4">
						<p class="font-mono text-xs uppercase tracking-wider text-ink-tertiary">筛选</p>
						<div class="mt-4">
							<FilterPanel client:load posts={data} />
						</div>
					</div>
				</aside>
			)}

			<div class="min-w-0 flex-1">
				<details class="mb-6 rounded-xl border border-hairline xl:hidden">
					<summary class="cursor-pointer select-none px-4 py-3 font-mono text-xs uppercase tracking-wider text-ink-tertiary">
						筛选
					</summary>
					<div class="border-t border-hairline px-4 py-4">
						<FilterPanel client:load posts={data} />
					</div>
				</details>

				<PostList client:load posts={data} />
			</div>

			{position === "right" && (
				<aside class="hidden w-48 shrink-0 xl:block" aria-label="筛选">
					<div class="sticky top-6 max-h-[calc(100dvh-3rem)] overflow-y-auto rounded-xl border border-hairline bg-paper p-4">
						<p class="font-mono text-xs uppercase tracking-wider text-ink-tertiary">筛选</p>
						<div class="mt-4">
							<FilterPanel client:load posts={data} />
						</div>
					</div>
				</aside>
			)}
		</div>
	</main>
</BaseLayout>
