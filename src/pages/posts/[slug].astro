---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleTree from "../../components/ArticleTree.astro";
import PostMeta from "../../components/PostMeta.astro";
import Toc from "../../components/Toc.astro";
import { getAllPosts, toPostData } from "../../lib/posts";
import { postUrl } from "../../config";
import { withNeighbors } from "../../lib/post-data";
import { render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getAllPosts();
	return posts.map((p) => ({
		params: { slug: p.id },
		props: { post: p, ...withNeighbors(posts, p.id), allPosts: posts },
	}));
}

const { post, prev, next, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const postData = toPostData(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
	<main class="w-full px-4 pt-14 pb-12">
		<div class="mx-auto flex w-full max-w-6xl items-start gap-10">
			<ArticleTree posts={allPosts} current={post.id} />
			<div class="min-w-0 flex-1">
				<Toc headings={headings} variant="collapsible" />

				<article>
					<header>
						<h1 class="text-3xl font-bold leading-snug tracking-tight">{post.data.title}</h1>
						<div class="mt-3">
							<PostMeta post={postData} />

						</div>
					</header>
					<div class="prose prose-neutral mt-10 max-w-none dark:prose-invert">
						<Content />
					</div>
					<footer class="mt-14 border-t border-hairline pt-6">
						<nav class="flex items-center justify-between gap-4 text-sm" aria-label="上下篇">
							{prev ? (
								<a href={postUrl(prev.id)} class="transition-colors hover:text-accent">

									← {prev.data.title}
								</a>
							) : (
								<span></span>
							)}
							{next ? (
								<a href={postUrl(next.id)} class="text-right transition-colors hover:text-accent">

									{next.data.title} →
								</a>
							) : (
								<span></span>
							)}
						</nav>
					</footer>
				</article>
			</div>
			<Toc headings={headings} variant="aside" />
		</div>
	</main>
</BaseLayout>
<script>
	import { initLightbox } from "../../lib/lightbox";
	initLightbox();
</script>
