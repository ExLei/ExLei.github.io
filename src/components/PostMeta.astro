---
import { formatPublishedDate, type PostData } from "../lib/post-data";

interface Props {
	post: PostData;
}

const { post } = Astro.props;
const date = formatPublishedDate(post.published);
---
<div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-ink-tertiary">
	<time datetime={post.published}>{date}</time>
	{post.category && <span class="text-accent">#{post.category}</span>}
	{post.tags.map((t) => (
		<span>#{t}</span>
	))}
	<span>{post.readingMinutes} 分钟阅读</span>
</div>
