---
import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---
{
	headings.length > 0 && (
		<aside class="sticky top-6 hidden w-48 shrink-0 xl:block" aria-label="文章大纲">
			<p class="font-mono text-xs uppercase tracking-wider text-ink-tertiary">目录</p>
			<nav class="mt-3 max-h-[calc(100dvh-3rem)] overflow-y-auto" aria-label="文章大纲">
				<ul id="toc-nav" class="space-y-1 text-[13px]">
					{headings.map((h) => (
						<li class:list={[h.depth === 2 ? "pl-0" : h.depth === 3 ? "pl-4" : "pl-8"]}>
							<a
								href={`#${h.slug}`}
								class="toc-link block py-0.5 leading-snug text-ink-secondary transition-colors hover:text-accent"
							>
								{h.text}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</aside>
	)
}

<script>
	// 滚动定位高亮（scrollspy）：当前可见小节对应的大纲项高亮
	// 通过 astro:page-load 重初始化，兼容 SWUP 无刷新导航
	function initScrollspy() {
		document.querySelectorAll(".toc-link.text-accent").forEach((a) => a.classList.remove("text-accent", "font-semibold"));
		const article = document.querySelector("article");
		const links = [...document.querySelectorAll(".toc-link")];
		if (!article || links.length === 0) return;

		const map = new Map();
		links.forEach((a) => {
			const href = a.getAttribute("href") ?? "";
			if (href.startsWith("#")) {
				const target = document.getElementById(href.slice(1));
				if (target) map.set(href.slice(1), a);
			}
		});
		if (map.size === 0) return;

		let current: string | null = null;
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						current = entry.target.id;
						document.querySelectorAll(".toc-link").forEach((a) => {
							const active = a.getAttribute("href") === `#${current}`;
							a.classList.toggle("text-accent", active);
							a.classList.toggle("font-semibold", active);
						});
					}
				}
			},
			{ rootMargin: "-15% 0px -75% 0px", threshold: 0 },
		);

		document.querySelectorAll("article h2[id], article h3[id], article h4[id]").forEach((h) => {
			if (map.has(h.id)) observer.observe(h);
		});
	}

	document.addEventListener("astro:page-load", initScrollspy);
	if (document.readyState !== "loading") initScrollspy();
</script>
