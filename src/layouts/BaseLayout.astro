---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import NavContainer from "../components/nav/NavContainer.astro";
import ThemeToggle from "../components/ThemeToggle.svelte";
import { siteConfig } from "../config";

interface Props {
	title?: string;
	description?: string;
	/** 从 Pagefind 搜索索引排除（如 404 页） */
	pagefindIgnore?: boolean;
}

const { title, description, pagefindIgnore } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
---
<!doctype html>
<html lang={siteConfig.lang} data-pagefind-ignore={pagefindIgnore || undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description ?? siteConfig.description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={new URL("/favicon.svg", Astro.site).pathname} />
		<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={new URL("/rss.xml", Astro.site).pathname} />
		<ClientRouter />
		<script is:inline>
			// 主题「决策者」：首屏防闪烁（head 先行）+ View Transitions 导航重置
			// <html> 属性后重新应用。lib/theme.svelte.ts 从 DOM 单向同步状态。
			(function () {
				function applyTheme() {
					var saved = localStorage.getItem("theme");
					var dark =
						saved === "dark" ||
						(saved !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
					document.documentElement.classList.toggle("dark", dark);
				}
				applyTheme();
				document.addEventListener("astro:page-load", applyTheme);
			})();
		</script>
	</head>
	<body>
		<div>
			<slot />
			<footer>
				<div
					class="mx-auto w-full max-w-2xl px-4 pb-24 text-center font-mono text-xs text-ink-tertiary"
				>
					© {new Date().getFullYear()} {siteConfig.author.name} ·{" "}
					<a
						href={new URL("/rss.xml", Astro.site).pathname}
						class="transition-colors hover:text-accent"
					>
						RSS 订阅
					</a>
				</div>
			</footer>
		</div>
		<div transition:persist="theme">
			<ThemeToggle client:load />
		</div>
		<NavContainer />
	</body>
</html>
